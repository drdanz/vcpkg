diff --git a/CMakeLists.txt b/CMakeLists.txt
index aad02e1..dd45e44 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -181,12 +181,9 @@ if(NOT STATIC_ONLY AND NOT SHARED_ONLY)
   )
 endif()
 
+# The static libraries define these as usage requirements, pkg-config users get them from libical.pc
 if(STATIC_ONLY)
-  add_definitions(
-    -DLIBICAL_ICAL_STATIC_DEFINE
-    -DLIBICAL_ICALSS_STATIC_DEFINE
-    -DLIBICAL_VCAL_STATIC_DEFINE
-  )
+  set(LIBICAL_STATIC_CFLAGS " -DLIBICAL_ICAL_STATIC_DEFINE -DLIBICAL_ICALSS_STATIC_DEFINE -DLIBICAL_VCAL_STATIC_DEFINE")
 endif()
 
 # must have Perl to create the derived stuff
diff --git a/libical.pc.in b/libical.pc.in
index c07eb52..e0836b5 100644
--- a/libical.pc.in
+++ b/libical.pc.in
@@ -9,4 +9,4 @@ Version: @LIBICAL_LIB_VERSION_STRING@
 Libs: -L${libdir} -lical -licalss -licalvcal
 Libs.private: @PTHREAD_LIBS@
 @REQUIRES_PRIVATE_ICU@
-Cflags: -I${includedir}
+Cflags: -I${includedir}@LIBICAL_STATIC_CFLAGS@
